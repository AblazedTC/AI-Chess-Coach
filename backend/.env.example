# Offline, reproducible defaults. No credentials required.
CHESSCOM_MODE=demo
ENGINE_MODE=demo
LLM_PROVIDER=deterministic
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
# Opt in to the public, unauthenticated Chess.com API:
# CHESSCOM_MODE=live
# Native Stockfish is supplied by the operator, not bundled:
# ENGINE_MODE=stockfish
# STOCKFISH_PATH=C:\tools\stockfish\stockfish.exe
# ENGINE_DEPTH=12
# ENGINE_TIME_SECONDS=0.3
# ENGINE_TIMEOUT_SECONDS=10
# Optional, paid provider: enabled only by explicit configuration.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-locally
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
